    @page
@model EntregasModel
@{
    ViewData["Title"] = "EntregasModel";
}
<form method="post"
      enctype="multipart/form-data">
      
      
    <div class="text-center">
        

           @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmid"
                   type="hidden"
                   asp-for="@Model.Actual!.id" />
        }


        @if (Model.Formulario)
        {
            <div style="display: grid; grid-template-columns: 140px 1fr; gap: 10px; max-width: 450px; align-items: center;">
                <h3 style="grid-column: span 2; margin-bottom: 5px;">Entregas</h3>

               <label for="nmDomicilio">Domicilio</label>
                <select id="nmDomicilio" asp-for="@Model.Actual!.id_domicilio" style="padding: 5px;">
                    <option value="">Seleccione un Domicilio</option>

                    @if (Model.ListaDomicilios != null)
                    {
                        @foreach (var domicilios in Model.ListaDomicilios)
                        {
                            <option value="@domicilios.id"> @domicilios.id / @domicilios.direccion / @domicilios.numeroDeTelefono  </option>

                        }
                    }
                </select>

                <label for="nmEmpleado">Empleado</label>
                <select id="nmEmpleado" asp-for="@Model.Actual!.id_empleado" style="padding: 5px;">
                    <option value="">Seleccione un empleado</option>

                    @if (Model.listaEmpleados != null)
                    {
                        @foreach (var empleados in Model.listaEmpleados)
                        {
                            <option value="@empleados.id"> @empleados.id / @empleados.carnet</option>

                        }
                    }
                </select>

                <label for="nmFechaSalida"> Fecha Salida </label>
                <input id="nmFechaSalida" asp-for="@Model.Actual!.fechaSalida" style="padding: 5px;" />

                <label for="nmFechallegada">Fecha llegada</label>
                <input id="nmFechallegada" asp-for="@Model.Actual!.fechaLlegada" style="padding: 5px;" />
                <label>
                    Imagen
                </label>
                @if (Model.Actual!.imagen != null)
                {
                    <img height="100"
                        width="100"
                        src="data:image;base64,
                            @System.Convert.ToBase64String(
                            Convert.FromBase64String(
                            Model.Actual!.imagen))" />
                }
                <input type="file"
                    asp-for="FormFile" />


                <div style="grid-column: span 2; display: flex; gap: 10px; margin-top: 10px;">
                    <input type="submit" value="Agregar Entrega" class="btn btn-secondary" asp-page-handler="BtGuardar" />
                    <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtBuscar" />
                </div>
            </div>
        }


        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!._domicilio.direccion
                        @Model.Actual!.fechaSalida
                        @Model.Actual!.fechaLlegada

                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />


                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {

            <h1 class="display-4 text-dark">Entregas</h1>

            <div style="display: flex; justify-content: space-between; align-items: center;">



                <input type="submit"
                       value="Nueva Entrega"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo" />

                <div>
                    <button asp-page-handler="BtBuscar">

                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR2Rx8reCe8jFoPAqd8gp0fb_TVuQQ_Vy4ObziJHpT1zkfUtYn7bX9BsWlf&s=10"
                             alt="Descripción de la imagen" width="24" height="24" />

                    </button>
                    <input id="flId"
                           placeholder="direccion "
                           asp-for="@Model.Filtro!._domicilio.direccion" />


                </div>


            </div>

            <br />
            <br />


            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Domicilio</th>
                        <th>Empleado</th>
                        <th>Fecha salida </th>
                        <th>Fecha llegada</th>
                        <th>Imagen</th>
                        <th></th>

                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {

                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._domicilio.direccion"</td>
                                <td>@elemento._empleado.carnet</td>
                                <td>@elemento.fechaSalida</td>
                                <td>@elemento.fechaLlegada</td>
                                <td>
                                    @if (elemento.imagen != null)
                                    {
                                        <img height="60"
                                             width="60"
                                             src="data:image;base64,
                                                @System.Convert.ToBase64String(
                                                Convert.FromBase64String(elemento.imagen))" />
                                    }
                                </td>
                                <input type="file"
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
