    @page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

<form method="post"
      enctype="multipart/form-data">
      
      
    <div class="text-center">
        

               
        @if (ViewData.ContainsKey("Mensaje"))
        {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmid"
                   type="hidden"
                   asp-for="@Model.Actual!.id" />
        }


        @if (Model.Formulario)
        {
            <div style="display: grid; grid-template-columns: 140px 1fr; gap: 10px; max-width: 450px; align-items: center;">
                <h3 style="grid-column: span 2; margin-bottom: 5px;">Usuarios</h3>

                <label for="nmUsuario">Usuario</label>
                <input id="nmUsuario" asp-for="@Model.Actual!.Usuario" style="padding: 5px;" />
                <label for="nmClave">Contraseña</label>
                <input id="nmClave" type="password" asp-for="@Model.Actual!.Contraseña" style="padding: 5px;" />
                <label for="nmRoles">Rol</label>
                <select id="nmRoles" asp-for="@Model.Actual!.rol" style="padding: 5px;">
                    <option value="">Seleccione un rol</option>

                    @if (Model.ListaRoles != null)
                    {
                        @foreach (var roles in Model.ListaRoles)
                        {
                            <option value="@roles.id"> @roles.id / @roles.nombre</option>
                        }
                    }
                </select>
                <label>
                    Imagen
                </label>
                @if (Model.Actual!.imagen != null)
                {
                    <img height="100"
                        width="100"
                        src="data:image;base64,
                            @System.Convert.ToBase64String(
                            Convert.FromBase64String(
                            Model.Actual!.imagen))" />
                }
                <input type="file"
                    asp-for="FormFile" />
                
                </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Usuario
                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />


                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {

            <h1 class="display-4 text-dark">Usuarios</h1>

            <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div></div>
                <div>
                    <button asp-page-handler="BtBuscar">

                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR2Rx8reCe8jFoPAqd8gp0fb_TVuQQ_Vy4ObziJHpT1zkfUtYn7bX9BsWlf&s=10"
                             alt="Descripción de la imagen" width="24" height="24" />

                    </button>
                    <input id="flUsuario"
                           placeholder="Usuario"
                           asp-for="@Model.Filtro!.Usuario" />


                </div>


            </div>

            <br />
            <br />


            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>

                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Imagen</th>
                        <th></th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Usuario</td>
                                <td>@elemento._roles.nombre</td>
                                <td> 
                                    @if (elemento.imagen != null)
                                    {
                                        <img height="60"
                                             width="60"
                                             src="data:image;base64,
                                                @System.Convert.ToBase64String(
                                                Convert.FromBase64String(elemento.imagen))" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
