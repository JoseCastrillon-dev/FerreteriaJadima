    @page
@model CuotasModel
@{
    ViewData["Title"] = "CuotasModel";
}
<form method="post"
      enctype="multipart/form-data">
      
      
    <div class="text-center">
        

               
        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmid"
                   type="hidden"
                   asp-for="@Model.Actual!.id" />
        }


        @if (Model.Formulario)
        {
            <div style="display: grid; grid-template-columns: 140px 1fr; gap: 10px; max-width: 450px; align-items: center;">
                <h3 style="grid-column: span 2; margin-bottom: 5px;">Cuotas</h3>

                <label for="nmCredito">Credito</label>
                <select id="nmCredito" asp-for="@Model.Actual!.id_credito" style="padding: 5px;">
                    <option value="">Seleccione una Credito</option>

                    @if (Model.ListaCreditos != null)
                    {
                        @foreach (var creditos in Model.ListaCreditos)
                        {
                            <option value="@creditos.id"> @creditos.id / @creditos._estadoCredito.estado </option>

                        }
                    }
                </select>

                <label for="nmTipoDePago">Tipos de pago</label>
                <select id="nmTipoDePago" asp-for="@Model.Actual!.id_tipoDePago" style="padding: 5px;">
                    <option value="">Seleccione un tipo de pago</option>

                    @if (Model.listaTiposDePagos != null)
                    {
                        @foreach (var tiposDePagos in Model.listaTiposDePagos)
                        {
                            <option value="@tiposDePagos.id"> @tiposDePagos.id / @tiposDePagos.metodo</option>

                        }
                    }
                </select>

               

                <label for="nmFechaPago">Fecha de Pago</label>
                <input id="nmFechaPago" asp-for="@Model.Actual!.fechaDePago" style="padding: 5px;" />

                <label for="nmValorCuota"> Valor cuota</label>
                <input id="nmValorCuota" asp-for="@Model.Actual!.valorDeCuota" style="padding: 5px;" />

                <label for="nmNumeroDeCuota">Numero Cuota</label>
                <input id="nmNumeroDeCuota" asp-for="@Model.Actual!.numeroDeCuota" style="padding: 5px;" />


                <div style="grid-column: span 2; display: flex; gap: 10px; margin-top: 10px;">
                    <input type="submit" value="Agregar Cuota" class="btn btn-secondary" asp-page-handler="BtGuardar" />
                    <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtBuscar" />
                </div>
            </div>
        }


        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!._credito._estadoCredito.estado
                        @Model.Actual!.fechaDePago
                        @Model.Actual!.valorDeCuota

                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />


                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {

            <h1 class="display-4 text-dark">Cuotas</h1>

            <div style="display: flex; justify-content: space-between; align-items: center;">



                <input type="submit"
                       value="Nueva Cuota"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo" />

                <div>
                    <button asp-page-handler="BtBuscar">

                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR2Rx8reCe8jFoPAqd8gp0fb_TVuQQ_Vy4ObziJHpT1zkfUtYn7bX9BsWlf&s=10"
                             alt="Descripción de la imagen" width="24" height="24" />

                    </button>
                    <input id="flId"
                           placeholder="Estado credito "
                           asp-for="@Model.Filtro!._credito._estadoCredito.estado" />


                </div>


            </div>

            <br />
            <br />


            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Credito Estado Credito</th>
                        <th>Tipo de pago</th>
                        <th>Fecha de pago </th>
                        <th>Valor de cuota</th>
                        <th>numero cuota</th>

                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {

                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._credito._estadoCredito.estado"</td>
                                <td>@elemento._tipoDePago.metodo</td>
                                <td>@elemento.fechaDePago</td>
                                <td>@elemento.valorDeCuota</td>
                                <td>@elemento.numeroDeCuota</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
