    @page
@model VentasModel
@{
    ViewData["Title"] = "Ventas";
}
<form method="post"
      enctype="multipart/form-data">
      
      
    <div class="text-center">
        

               
        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmid"
                   type="hidden"
                   asp-for="@Model.Actual!.id" />
        }


        @if (Model.Formulario)
        {
            <div style="display: grid; grid-template-columns: 140px 1fr; gap: 10px; max-width: 450px; align-items: center;">
                <h3 style="grid-column: span 2; margin-bottom: 5px;">Ventas</h3>

                <label for="nmDetalleVentas">Detalle Ventas</label>
                <select id="nmDetalleVentas" asp-for="@Model.Actual!.id_detalleVenta" style="padding: 5px;">
                    <option value="">Seleccione un detalle venta</option>

                    @if (Model.ListaDetalleVentas != null)
                    {
                        @foreach (var detalleVentas in Model.ListaDetalleVentas)
                        {
                            <option value="@detalleVentas.id"> @detalleVentas.id / @detalleVentas._producto.codigo / @detalleVentas.cantidad  </option>

                        }
                    }
                </select>

                <label for="nmTipoDePago">Tipo De pago</label>
                <select id="nmTipoDePago" asp-for="@Model.Actual!.id_tipoDePago" style="padding: 5px;">
                    <option value="">Seleccione un Tipo de pago</option>

                    @if (Model.ListaTiposDePagos != null)
                    {
                        @foreach (var tiposDePagos in Model.ListaTiposDePagos)
                        {
                            <option value="@tiposDePagos.id"> @tiposDePagos.id / @tiposDePagos.metodo</option>

                        }
                    }
                </select>

                <label for="nmEmpleado">Empleado</label>
                <select id="nmEmpleado" asp-for="@Model.Actual!.id_empleado" style="padding: 5px;">
                    <option value="">Seleccione un empleado</option>

                    @if (Model.ListaEmpleados != null)
                    {
                        @foreach (var empleados in Model.ListaEmpleados)
                        {
                            <option value="@empleados.id"> @empleados.id / @empleados.carnet</option>

                        }
                    }
                </select>


                <label for="nmCliente">Cliente</label>
                <select id="nmCliente" asp-for="@Model.Actual!.id_cliente" style="padding: 5px;">
                    <option value="">Seleccione un cliente</option>

                    @if (Model.ListaClientes != null)
                    {
                        @foreach (var clientes in Model.ListaClientes)
                        {
                            <option value="@clientes.id"> @clientes.id / @clientes._persona.nombre</option>

                        }
                    }
                </select>

               

                <label for="nmIva">Iva</label>
                <input id="nmIva" asp-for="@Model.Actual!.iva" style="padding: 5px;" />

                <label for="nmTotal">Total</label>
                <input id="nmTotal" asp-for="@Model.Actual!.total" style="padding: 5px;" />


                <div style="grid-column: span 2; display: flex; gap: 10px; margin-top: 10px;">
                    <input type="submit" value="Agregar Venta" class="btn btn-secondary" asp-page-handler="BtGuardar" />
                    <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtBuscar" />
                </div>
            </div>
        }


        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!._detalleVenta._producto.codigo
                        @Model.Actual!._empleado.carnet
                        @Model.Actual!._cliente._persona.nombre

                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />


                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {

            <h1 class="display-4 text-dark">Ventas</h1>

            <div style="display: flex; justify-content: space-between; align-items: center;">



                <input type="submit"
                       value="Nueva Venta"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo" />

                <div>
                    <button asp-page-handler="BtBuscar">

                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR2Rx8reCe8jFoPAqd8gp0fb_TVuQQ_Vy4ObziJHpT1zkfUtYn7bX9BsWlf&s=10"
                             alt="Descripción de la imagen" width="24" height="24" />

                    </button>
                    <input id="flId"
                           placeholder="Codigo producto "
                           asp-for="@Model.Filtro!._detalleVenta._producto.codigo"/>


                </div>


            </div>

            <br />
            <br />


            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Detalle venta (codigo producto)</th>
                        <th>Tipo de pago</th>
                        <th>Empleado</th>
                        <th>cliente</th>
                        <th>Iva</th>
                        <th>Total</th>

                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {

                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._detalleVenta._producto.codigo</td>
                                <td>@elemento._tipoDePago.metodo</td>
                                <td>@elemento._empleado.carnet</td>
                                <td>@elemento._cliente._persona.nombre</td>
                                <td>@elemento.iva</td>
                                <td>@elemento.total</td>



                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
