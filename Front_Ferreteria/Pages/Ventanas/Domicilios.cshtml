    @page
@model DomiciliosModel
@{
    ViewData["Title"] = "DomiciliosModel";
}
<form method="post"
      enctype="multipart/form-data">
      
      
    <div class="text-center">
        

               
        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmid"
                   type="hidden"
                   asp-for="@Model.Actual!.id" />
        }


        @if (Model.Formulario)
        {
            <div style="display: grid; grid-template-columns: 140px 1fr; gap: 10px; max-width: 450px; align-items: center;">
                <h3 style="grid-column: span 2; margin-bottom: 5px;">Domicilios</h3>

               <label for="nmVenta">Venta</label>
                <select id="nmVenta" asp-for="@Model.Actual!.id_venta" style="padding: 5px;">
                    <option value="">Seleccione una Venta</option>

                    @if (Model.ListaVentas != null)
                    {
                        @foreach (var ventas in Model.ListaVentas)
                        {
                            <option value="@ventas.id"> @ventas.id / @ventas._detalleVenta._producto.codigo / @ventas.total  </option>

                        }
                    }
                </select>

                <label for="nmVehiculos">Vehiculos</label>
                <select id="nmVehiculos" asp-for="@Model.Actual!.id_vehiculo" style="padding: 5px;">
                    <option value="">Seleccione un vehiculo</option>

                    @if (Model.listaVehiculos != null)
                    {
                        @foreach (var vehiculos in Model.listaVehiculos)
                        {
                            <option value="@vehiculos.id"> @vehiculos.id / @vehiculos.matricula</option>

                        }
                    }
                </select>

                <label for="nmNumeroTelefono"> Numero Telefono </label>
                <input id="nmNumeroTelefono" asp-for="@Model.Actual!.numeroDeTelefono" style="padding: 5px;" />

                <label for="nmDireccion">Direccion</label>
                <input id="nmDireccion" asp-for="@Model.Actual!.direccion" style="padding: 5px;" />
                <label>
                    Imagen
                </label>
                @if (Model.Actual!.imagen != null)
                {
                    <img height="100"
                        width="100"
                        src="data:image;base64,
                            @System.Convert.ToBase64String(
                            Convert.FromBase64String(
                            Model.Actual!.imagen))" />
                }
                <input type="file"
                    asp-for="FormFile" />


                <div style="grid-column: span 2; display: flex; gap: 10px; margin-top: 10px;">
                    <input type="submit" value="Agregar Domicilios" class="btn btn-secondary" asp-page-handler="BtGuardar" />
                    <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtBuscar" />
                </div>
            </div>
        }


        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!._venta._detalleVenta._producto.codigo
                        @Model.Actual!.numeroDeTelefono
                        @Model.Actual!.direccion

                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />


                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {

            <h1 class="display-4 text-dark">Domicilios</h1>

            <div style="display: flex; justify-content: space-between; align-items: center;">



                <input type="submit"
                       value="Nuevo Domicilio"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo" />

                <div>
                    <button asp-page-handler="BtBuscar">

                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR2Rx8reCe8jFoPAqd8gp0fb_TVuQQ_Vy4ObziJHpT1zkfUtYn7bX9BsWlf&s=10"
                             alt="Descripción de la imagen" width="24" height="24" />

                    </button>
                    <input id="flId"
                           placeholder="direccion "
                           asp-for="@Model.Filtro!.direccion" />


                </div>


            </div>

            <br />
            <br />


            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Venta</th>
                        <th>Vehiculo</th>
                        <th>Numero Telefono </th>
                        <th>Direccion</th>
                        <th>Imagen</th>
                        <th></th>

                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {

                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._venta._detalleVenta._producto.codigo"</td>
                                <td>@elemento._vehiculos.matricula</td>
                                <td>@elemento.numeroDeTelefono</td>
                                <td>@elemento.direccion</td>
                                <td>
                                    @if (elemento.imagen != null)
                                    {
                                        <img height="60"
                                             width="60"
                                             src="data:image;base64,
                                                @System.Convert.ToBase64String(
                                                Convert.FromBase64String(elemento.imagen))" />
                                    }
                                </td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
