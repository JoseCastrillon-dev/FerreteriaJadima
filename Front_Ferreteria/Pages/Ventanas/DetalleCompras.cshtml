    @page
@model DetalleComprasModel
@{
    ViewData["Title"] = "DetalleCompras";
}
<form method="post"
      enctype="multipart/form-data">
      
      
    <div class="text-center">
        

               
        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmid"
                   type="hidden"
                   asp-for="@Model.Actual!.id" />
        }


        @if (Model.Formulario)
        {
            <div style="display: grid; grid-template-columns: 140px 1fr; gap: 10px; max-width: 450px; align-items: center;">
                <h3 style="grid-column: span 2; margin-bottom: 5px;">Detalle Compras</h3>

                <label for="nmCompra">Compra</label>
                <select id="nmCompra" asp-for="@Model.Actual!.id_compra" style="padding: 5px;">
                    <option value="">Seleccione una compra</option>

                    @if (Model.ListaCompras != null)
                    {
                        @foreach (var compras in Model.ListaCompras)
                        {
                            <option value="@compras.id"> @compras.id / @compras._empleado.carnet / @compras.fechaCompra  </option>

                        }
                    }
                </select>

                <label for="nmProducto">Producto</label>
                <select id="nmProducto" asp-for="@Model.Actual!.id_producto" style="padding: 5px;">
                    <option value="">Seleccione un Producto</option>

                    @if (Model.listaProductos != null)
                    {
                        @foreach (var productos in Model.listaProductos)
                        {
                            <option value="@productos.id"> @productos.id / @productos.codigo</option>

                        }
                    }
                </select>

               

                <label for="nmCantidad">Cantidad</label>
                <input id="nmCantidad" asp-for="@Model.Actual!.cantidad" style="padding: 5px;" />

                <label for="nmPreciosCompra">Precio Compra</label>
                <input id="nmPreciosCompra" asp-for="@Model.Actual!.preciosCompra" style="padding: 5px;" />
                <label>
                    Imagen
                </label>
                @if (Model.Actual!.imagen != null)
                {
                    <img height="100"
                        width="100"
                        src="data:image;base64,
                            @System.Convert.ToBase64String(
                            Convert.FromBase64String(
                            Model.Actual!.imagen))" />
                }
                <input type="file"
                    asp-for="FormFile" />


                <div style="grid-column: span 2; display: flex; gap: 10px; margin-top: 10px;">
                    <input type="submit" value="Agregar Detalle de compra" class="btn btn-secondary" asp-page-handler="BtGuardar" />
                    <input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtBuscar" />
                </div>
            </div>
        }


        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!._compra._empleado
                        @Model.Actual!._producto.codigo
                        @Model.Actual!.cantidad

                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />


                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {

            <h1 class="display-4 text-dark">Detalle Compras</h1>

            <div style="display: flex; justify-content: space-between; align-items: center;">



                <input type="submit"
                       value="Nuevo Detalle Compra"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo" />

                <div>
                    <button asp-page-handler="BtBuscar">

                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR2Rx8reCe8jFoPAqd8gp0fb_TVuQQ_Vy4ObziJHpT1zkfUtYn7bX9BsWlf&s=10"
                             alt="Descripción de la imagen" width="24" height="24" />

                    </button>
                    <input id="flId"
                           placeholder="Carnet empleado "
                           asp-for="@Model.Filtro!._compra._empleado.carnet"/>


                </div>


            </div>

            <br />
            <br />


            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Compra</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio compra</th>
                        <th>Imagen</th>
                        <th></th>

                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {

                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._compra._empleado.carnet</td>
                                <td>@elemento._producto.codigo</td>
                                <td>@elemento.cantidad</td>
                                <td>@elemento.preciosCompra</td>
                                <td>
                                    @if (elemento.imagen != null)
                                    {
                                        <img height="60"
                                             width="60"
                                             src="data:image;base64,
                                                @System.Convert.ToBase64String(
                                                Convert.FromBase64String(elemento.imagen))" />
                                    }
                                </td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
